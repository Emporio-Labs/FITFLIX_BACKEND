{
	"name": "hybridhuman",
	"module": "index.ts",
	"type": "module",
	"private": true,
	"scripts": {
		"dev": "bun run index.ts",
		"start": "bun run index.ts",
		"build": "bun run build:vercel",
		"build:vercel": "bun build api/index.ts --target=node --format=cjs --outfile=api/index.bundle.cjs && node scripts/postbuild.js",
		"create:admin": "bun run scripts/create-admin.ts",
		"migrate:credits": "bun run scripts/migrate-credits.ts",
		"seed:exercises": "bun run scripts/seed-exercises.ts",
		"import:meal-plan": "bun run scripts/import-meal-plan.ts",
		"export:meal-plan": "bun run scripts/export-meal-plan.ts",
		"test:onboarding-flow": "bun run tests/onboarding/full-onboarding-flow.test.ts",
		"test:clinical-review": "bun run tests/onboarding/clinical-review-flow.test.ts",
		"test:community": "bun run tests/community/community-foundation.test.ts",
		"test:community-posts": "COMMUNITY_MAX_IMAGE_BYTES=10485760 bun run tests/community/posts-feed.test.ts",
		"test:community-engagement": "bun run tests/community/engagement.test.ts",
		"test:community-moderation": "bun run tests/community/moderation.test.ts",
		"seed:community": "bun run scripts/seed-community.ts",
		"community:smoke": "bun run scripts/community-smoke.ts",
		"community:setup": "bun run scripts/community-setup.ts",
		"community:teardown": "bun run scripts/community-setup.ts --down",
		"migrate:passwords": "bun run scripts/migrate-passwords.ts",
		"test:community-profiles": "bun run tests/community/profiles.test.ts"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.4.8",
		"@types/bun": "latest",
		"@types/jsonwebtoken": "^9.0.10",
		"@types/multer": "^2.1.0",
		"@types/node": "^25.9.1",
		"@types/pdf-parse": "^1.1.5",
		"@types/pdfkit": "^0.17.6"
	},
	"peerDependencies": {
		"typescript": "^5"
	},
	"dependencies": {
		"@aws-sdk/client-s3": "^3.1053.0",
		"@aws-sdk/s3-request-presigner": "^3.1053.0",
		"@types/express": "^5.0.6",
		"bcryptjs": "^3.0.3",
		"dotenv": "^17.3.1",
		"express": "^5.2.1",
		"firebase-admin": "^13.10.0",
		"googleapis": "^171.4.0",
		"jimp": "^1.6.1",
		"jsonwebtoken": "^9.0.2",
		"mongoose": "^9.3.1",
		"multer": "^2.2.0",
		"openai": "^6.33.0",
		"pdf-parse": "^2.4.5",
		"pdfkit": "^0.18.0",
		"socket.io": "^4.8.3",
		"xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
		"zod": "^4.3.6"
	},
	"overrides": {
		"form-data": "^2.5.6",
		"protobufjs": "^7.6.3",
		"ws": "^8.21.0",
		"uuid": "^11.1.1"
	}
}
