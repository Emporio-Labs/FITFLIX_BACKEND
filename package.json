{
	"name": "hybridhuman",
	"module": "index.ts",
	"type": "module",
	"private": true,
	"scripts": {
		"dev": "bun run index.ts",
		"start": "bun run index.ts",
		"build": "bun run build:vercel",
		"build:vercel": "bun build api/index.ts --target=node --format=cjs --outfile=api/index.bundle.cjs && echo module.exports = handler; >> api/index.bundle.cjs",
		"create:admin": "bun run scripts/create-admin.ts",
		"migrate:credits": "bun run scripts/migrate-credits.ts",
		"seed:exercises": "bun run scripts/seed-exercises.ts",
		"test:onboarding-flow": "bun run tests/onboarding/full-onboarding-flow.test.ts",
		"test:clinical-review": "bun run tests/onboarding/clinical-review-flow.test.ts"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.4.8",
		"@types/bun": "latest",
		"@types/jsonwebtoken": "^9.0.10",
		"@types/multer": "^2.1.0",
		"@types/node": "^25.9.1",
		"@types/pdf-parse": "^1.1.5",
		"@types/pdfkit": "^0.17.6"
	},
	"peerDependencies": {
		"typescript": "^5"
	},
	"dependencies": {
		"@aws-sdk/client-s3": "^3.1053.0",
		"@aws-sdk/s3-request-presigner": "^3.1053.0",
		"@types/express": "^5.0.6",
		"bcryptjs": "^3.0.3",
		"dotenv": "^17.3.1",
		"express": "^5.2.1",
		"firebase-admin": "^13.10.0",
		"googleapis": "^171.4.0",
		"jsonwebtoken": "^9.0.2",
		"mongoose": "^9.3.1",
		"multer": "^2.1.1",
		"openai": "^6.33.0",
		"pdf-parse": "^2.4.5",
		"pdfkit": "^0.18.0",
		"socket.io": "^4.8.3",
		"zod": "^4.3.6"
	}
}
