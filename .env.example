PORT=3000
NODE_ENV=development
MONGODB_URL=

CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001
CORS_DEBUG=false
ERROR_VERBOSE=true

JWT_SECRET=
JWT_EXPIRES_IN=240d
JWT_REFRESH_SECRET=
JWT_REFRESH_EXPIRES_IN=240d
JWT_ISSUER=
JWT_AUDIENCE=

WEBHOOK_SECRET=

# Google OAuth credentials (used by Google Meet integration)
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REDIRECT_URI=
GMAIL_REFRESH_TOKEN=

# =====================================================
# ACTIVEX BCA API (Body Composition Analysis)
# =====================================================
ACTIVEX_BASE_URL=https://api.activex.ai/external/bca
ACTIVEX_API_KEY=
# How many days back to request scans for when syncing (used as the `Date` filter).
ACTIVEX_BCA_LOOKBACK_DAYS=365

PASSWORD_SALT_ROUNDS=10

AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=10

# =====================================================
# CAL ID CONFIGURATION
# =====================================================
CALID_API_KEY=
CALID_WEBHOOK_SECRET=
CALID_BASE_URL=https://api.cal.id
CALID_EVENT_TYPE_SPORTS_SCIENTIST=
CALID_EVENT_TYPE_NUTRITIONIST=
CALID_DEFAULT_TIMEZONE=Asia/Kolkata
CALID_MOCK=false


FCM_SERVICE_ACCOUNT_JSON=

# ZEGOCLOUD Credentials
ZEGO_APP_ID=
ZEGO_APP_SIGN=
ZEGO_SERVER_SECRET=

# Group class / live stream room lifecycle (src/utils/zego-room.ts).
# Timezone that ScheduledSession's "HH:mm" wall-clock fields are read in.
BUSINESS_TIMEZONE=Asia/Kolkata
# Minutes before an occurrence's start that its room is provisioned and the
# host may join. Per-class override: Class.occurrenceLeadMinutes.
SESSION_ROOM_LEAD_MINUTES=30
# Minutes after an occurrence's scheduled end that its room is torn down
# (everyone kicked, session marked COMPLETED) if the host hasn't ended it.
SESSION_ROOM_EXPIRY_MINUTES=30

# Shared secret required on the x-internal-secret (or x-webhook-secret) header
# for POST /internal/* routes, including /internal/sessions/lifecycle/tick —
# hit that route every minute from an external scheduler (cron-job.org,
# GitHub Actions, Upstash QStash); Vercel's own cron entry only fires daily.
REMINDER_TICK_SECRET=