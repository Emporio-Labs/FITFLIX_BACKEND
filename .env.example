PORT=3000
NODE_ENV=development
MONGODB_URL=

CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001
CORS_DEBUG=false
ERROR_VERBOSE=true

JWT_SECRET=
JWT_EXPIRES_IN=12h
JWT_ISSUER=
JWT_AUDIENCE=

WEBHOOK_SECRET=

PUBSUB_TOPIC=
ENABLE_GMAIL_WATCH=false
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REDIRECT_URI=
GMAIL_REFRESH_TOKEN=

LLM_PROVIDER=openai
OPENAI_API_KEY=
GROK_API_KEY=
GROQ_API_KEY=
GROK_BASE_URL=https://api.x.ai/v1
GROQ_BASE_URL=https://api.groq.com/openai/v1
HPOD_LLM_MODEL=gpt-4o
GROK_LLM_MODEL=grok-2-latest
GROQ_LLM_MODEL=openai/gpt-oss-120b
HPOD_MAX_PDF_TEXT_CHARS=60000

PASSWORD_SALT_ROUNDS=10

AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=10

# =====================================================
# CAL ID CONFIGURATION
# =====================================================
CALID_API_KEY=
CALID_WEBHOOK_SECRET=
CALID_BASE_URL=https://api.cal.id
CALID_EVENT_TYPE_SPORTS_SCIENTIST=
CALID_EVENT_TYPE_NUTRITIONIST=
CALID_DEFAULT_TIMEZONE=Asia/Kolkata
CALID_MOCK=false


FCM_SERVICE_ACCOUNT_JSON=

# =====================================================
# BOOKING WINDOW CONFIGURATION
# =====================================================
# The booking window threshold (how many hours before a class start time
# bookings are accepted) is stored in the MongoDB AppSettings singleton
# document, NOT as an environment variable.
#
# Default value: 72 hours (3 days before class start).
#
# To change it, update the `bookingWindowOpenHours` field on the AppSettings
# document with key "global" in your MongoDB database. The running server
# caches this value for up to 60 seconds before re-fetching.